# Public-artifact allowlist: ignore everything unless explicitly included.
*

!.gitignore
!README.md
!LICENSE
!CITATION.cff
!requirements.txt

!configs/
!configs/**
!src/
!src/harnesses/
!src/harnesses/margin_aware_splitting_harness.py
!exp/
!exp/experiment_components.py
!exp/run_experiments.py
!exp/extract_threshold_case.py
!exp/make_figures.py
!scripts/
!scripts/*.py
!scripts/*.ps1
!results/
!results/raw/
!results/raw/*.csv
!results/summary/
!results/summary/*.csv
!results/summary/*.json
!results/summary/*.md
!figures/
!figures/figure*.png
!figures/figure*.pdf
!metadata/
!metadata/*.json
!metadata/*.log
!tests/
!tests/*.py

# Never publish manuscript/review/build files or raw downloaded datasets.
main.tex
reply.tex
*.pdf
!figures/figure*.pdf
*.aux
*.bbl
*.blg
*.log
!metadata/*.log
*.out
*.toc
data/
tmp/
**/__pycache__/
*.pyc
.venv/
.pytest_cache/
